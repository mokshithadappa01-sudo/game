<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#070714">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Neon Orbit: Gravity Dash</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            -webkit-tap-highlight-color: transparent;
        }
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #030308;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            color: #ffffff;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        /* Desktop Phone Frame & Responsive Mobile Fullscreen */
        #app-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle at center, #111128 0%, #030308 100%);
        }
        #phone-frame {
            position: relative;
            width: 100%;
            height: 100%;
            background: #070714;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        @media (min-width: 500px) {
            #phone-frame {
                height: 92vh;
                max-height: 880px;
                aspect-ratio: 9 / 16;
                width: auto;
                border-radius: 36px;
                border: 6px solid #1e1e38;
                box-shadow: 0 0 60px rgba(0, 243, 255, 0.15), inset 0 0 20px rgba(0, 0, 0, 0.8);
            }
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
            touch-action: none;
        }
        /* Neon Glow Utilities */
        .neon-text-cyan {
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.8), 0 0 25px rgba(0, 243, 255, 0.4);
        }
        .neon-text-pink {
            text-shadow: 0 0 10px rgba(255, 0, 128, 0.8), 0 0 25px rgba(255, 0, 128, 0.4);
        }
        .neon-box-cyan {
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.35), inset 0 0 10px rgba(0, 243, 255, 0.15);
            border: 1.5px solid rgba(0, 243, 255, 0.6);
        }
        .neon-btn-primary {
            background: linear-gradient(135deg, #00f3ff 0%, #0077ff 100%);
            box-shadow: 0 0 25px rgba(0, 243, 255, 0.5);
            transition: transform 0.12s ease, box-shadow 0.12s ease;
        }
        .neon-btn-primary:active {
            transform: scale(0.95);
            box-shadow: 0 0 12px rgba(0, 243, 255, 0.8);
        }
        .glass-panel {
            background: rgba(13, 14, 32, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        @keyframes pulse-slow {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.04); opacity: 0.9; }
        }
        .animate-pulse-slow {
            animation: pulse-slow 2.2s infinite ease-in-out;
        }
        /* Custom Scrollbar for Modals */
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.03);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 243, 255, 0.4);
            border-radius: 10px;
        }
    </style>
</head>
<body>

<div id="app-wrapper">
    <div id="phone-frame">
        
