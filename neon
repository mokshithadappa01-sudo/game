function startGame() {
    audio.init();
    resetGame();
    gameState = 'PLAYING';

    menuScreen.classList.add('hidden');
    gameoverScreen.classList.add('hidden');
    menuBest.classList.add('hidden');
    hudScore.classList.remove('hidden');
    btnPause.classList.remove('hidden');
}

function endGame(reasonText) {
    gameState = 'GAMEOVER';
    audio.playCrash();
    triggerHaptic([40, 30, 60]);
    triggerScreenShake(12, 18);
    spawnParticles(player.x, player.y, '#ff1e42', 32, 6);

    const isNewRecord = score > saveData.highScore;
    if (isNewRecord) {
        saveData.highScore = score;
        writeSaveData();
    }

    document.getElementById('death-reason').textContent = reasonText;
    document.getElementById('go-score').textContent = score;
    document.getElementById('go-best').textContent = saveData.highScore;

    const badge = document.getElementById('new-best-badge');
    if (isNewRecord && score > 0) badge.classList.remove('hidden');
    else badge.classList.add('hidden');

    const bonusBtn = document.getElementById('btn-claim-bonus');
    bonusBtn.classList.remove('hidden');

    hudScore.classList.add('hidden');
    hudCombo.classList.add('hidden');
    btnPause.classList.add('hidden');
    menuBest.classList.remove('hidden');

    setTimeout(() => {
        if (gameState === 'GAMEOVER') {
            gameoverScreen.classList.remove('hidden');
        }
    }, 450);
}

function renderShop() {
