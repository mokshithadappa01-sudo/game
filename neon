        }`;

        const orbStyle = skin.trailColor === 'rainbow'
            ? 'background: linear-gradient(135deg, #00f3ff, #ff007f, #fbbf24);'
            : `background: ${skin.glowColor}; box-shadow: 0 0 14px ${skin.glowColor};`;

        card.innerHTML = `
            <div>
                <div class="flex items-center justify-between mb-2">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center" style="${orbStyle}">
                        <div class="w-4 h-4 rounded-full bg-white"></div>
                    </div>
                    ${isEquipped ? '<span class="text-[10px] font-orbitron font-bold text-cyan-300 bg-cyan-500/20 px-2 py-0.5 rounded-full">EQUIPPED</span>' : ''}
                </div>
                <div class="font-orbitron font-bold text-sm text-white">${skin.name}</div>
                <p class="text-[11px] text-slate-400 mt-0.5 leading-snug">${skin.desc}</p>
            </div>
            <button class="mt-3 w-full py-2 rounded-xl font-orbitron font-bold text-xs transition ${
                isEquipped
                    ? 'bg-slate-800 text-slate-400 cursor-default'
                    : isUnlocked
                        ? 'bg-cyan-500 text-slate-950 hover:bg-cyan-400'
                        : saveData.shards >= skin.price
                            ? 'bg-amber-400 text-slate-950 hover:bg-amber-300'
                            : 'bg-slate-800 text-slate-500 cursor-not-allowed'
            }">
                ${isEquipped ? 'ACTIVE' : isUnlocked ? 'EQUIP' : `UNLOCK (${skin.price} ★)`}
            </button>
        `;

        const btn = card.querySelector('button');
        btn.addEventListener('click', () => {
            if (isEquipped) return;
            if (isUnlocked) {
                saveData.equippedSkin = skin.id;
                writeSaveData();
                audio.playLatch(2);
                renderShop();
            } else if (saveData.shards >= skin.price) {
                saveData.shards -= skin.price;
                saveData.unlockedSkins.push(skin.id);
                saveData.equippedSkin = skin.id;
                writeSaveData();
                audio.playUnlock();
                triggerHaptic(35);
                renderShop();
            } else {
                showToast('Need more Star Shards!');
            }
        });

        grid.appendChild(card);
    });
}

function showToast(msg) {
    const t = document.getElementById('toast-msg');
    t.textContent = msg;
    t.style.opacity = '1';
    setTimeout(() => {
        t.style.opacity = '0';
    }, 2000);
}

// ==========================================
// 7. INPUT LISTENERS (TOUCH, MOUSE, KEYBOARD)
// ==========================================
canvas.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    if (gameState === 'PLAYING') {
        launchPlayer();
    }
});

window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' || e.code === 'ArrowUp') {
        if (gameState === 'PLAYING') {
            e.preventDefault();
            launchPlayer();
        } else if (gameState === 'MENU') {
            startGame();
        } else if (gameState === 'GAMEOVER') {
            startGame();
        }
    }
});

// UI Buttons
document.getElementById('btn-play').addEventListener('click', startGame);
document.getElementById('btn-retry').addEventListener('click', startGame);

document.getElementById('btn-go-menu').addEventListener('click', () => {
    gameoverScreen.classList.add('hidden');
    menuScreen.classList.remove('hidden');
    gameState = 'MENU';
    resetGame();
});

document.getElementById('btn-claim-bonus').addEventListener('click', (e) => {
    if (bonusClaimedThisRun) return;
    bonusClaimedThisRun = true;
    saveData.shards += 25;
    writeSaveData();
    audio.playUnlock();
    e.currentTarget.classList.add('hidden');
    showToast('+25 Star Shards Added!');
});

document.getElementById('btn-open-shop').addEventListener('click', () => {
    renderShop();
    shopModal.classList.remove('hidden');
});

document.getElementById('btn-go-shop').addEventListener('click', () => {
    renderShop();
    shopModal.classList.remove('hidden');
});

document.getElementById('btn-close-shop').addEventListener('click', () => {
    shopModal.classList.add('hidden');
});

document.getElementById('btn-toggle-audio').addEventListener('click', () => {
    saveData.soundEnabled = !saveData.soundEnabled;
    writeSaveData();
    if (saveData.soundEnabled) audio.playLatch(1);
});

document.getElementById('btn-toggle-haptics').addEventListener('click', () => {
    saveData.hapticsEnabled = !saveData.hapticsEnabled;
    writeSaveData();
    if (saveData.hapticsEnabled) triggerHaptic(25);
});

btnPause.addEventListener('click', () => {
    if (gameState === 'PLAYING') {
        gameState = 'PAUSED';
        showToast('Game Paused - Tap Pause to Resume');
    } else if (gameState === 'PAUSED') {
        gameState = 'PLAYING';
    }
});

// Play Store Export Guide Modal
document.getElementById('btn-export-guide').addEventListener('click', () => {
    exportModal.classList.remove('hidden');
});
document.getElementById('btn-close-export').addEventListener('click', () => {
    exportModal.classList.add('hidden');
});
document.getElementById('btn-done-export').addEventListener('click', () => {
    exportModal.classList.add('hidden');
});

document.getElementById('btn-copy-cap').addEventListener('click', () => {
    const cmd = `npm init -y\nnpm install @capacitor/core @capacitor/cli @capacitor/android\nnpx cap init "Neon Orbit" com.yourstudio.neonorbit --web-dir dist\nnpx cap add android\nnpx cap open android`;
    const ta = document.createElement('textarea');
    ta.value = cmd;
    document.body.appendChild(ta);
    ta.select();
    try {
        document.execCommand('copy');
        showToast('CLI Commands Copied!');
    } catch (err) {}
    document.body.removeChild(ta);
});

// Initialize on Load
window.onload = function () {
    resizeCanvas();
    loadSaveData();
    initStars();
    resetGame();
    gameLoop();
};
</script>
</body>
</html>
