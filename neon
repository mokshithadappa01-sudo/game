function updateHUD() {
    hudScore.textContent = score;
    if (combo > 1) {
        hudCombo.textContent = `COMBO x${combo}`;
        hudCombo.classList.remove('hidden');
    } else {
        hudCombo.classList.add('hidden');
    }
