<script>
/**
 * NEON ORBIT: GRAVITY DASH
 * Complete Mobile-First HTML5 Arcade Game
 */

// ==========================================
// 1. COSMETIC SKINS CATALOG & STORAGE
// ==========================================
const SKINS = [
    {
        id: 'cyber_cyan',
        name: 'Cyber Cyan',
        price: 0,
        coreColor: '#ffffff',
        glowColor: '#00f3ff',
        trailColor: '#00f3ff',
        desc: 'Standard issue hyper-drive core.'
    },
    {
        id: 'solar_flare',
        name: 'Solar Flare',
        price: 50,
        coreColor: '#fffbeb',
        glowColor: '#ff6b00',
        trailColor: '#ffaa00',
        desc: 'Blazing plasma forged in a supernova.'
    },
    {
        id: 'void_purple',
        name: 'Void Phantom',
        price: 100,
        coreColor: '#f3e8ff',
        glowColor: '#a855f7',
        trailColor: '#d946ef',
        desc: 'Harnesses dark matter gravitational waves.'
    },
    {
        id: 'emerald_matrix',
        name: 'Emerald Matrix',
        price: 150,
        coreColor: '#ecfdf5',
        glowColor: '#10b981',
        trailColor: '#34d399',
        desc: 'Overclocked bio-digital energy pulse.'
    },
    {
        id: 'crimson_valkyrie',
        name: 'Crimson Nova',
        price: 250,
        coreColor: '#ffe4e6',
        glowColor: '#f43f5e',
        trailColor: '#fb7185',
        desc: 'High-velocity tactical redshift drive.'
    },
    {
        id: 'rainbow_prism',
        name: 'Hyper Prism',
        price: 400,
        coreColor: '#ffffff',
        glowColor: '#00f3ff',
        trailColor: 'rainbow',
        desc: 'Chromatic spectrum trail that shifts hues.'
    }
];

const STORAGE_KEY = 'neon_orbit_save_v1';
let saveData = {
    highScore: 0,
    shards: 40, // Starter shards so player is close to first unlock
    unlockedSkins: ['cyber_cyan'],
    equippedSkin: 'cyber_cyan',
    soundEnabled: true,
    hapticsEnabled: true
};

function loadSaveData() {
    try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
            const parsed = JSON.parse(raw);
            saveData = { ...saveData, ...parsed };
        }
    } catch (e) {
        console.warn('localStorage unavailable, using memory state.');
    }
    updateTopUI();
}

function writeSaveData() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saveData));
    } catch (e) {}
    updateTopUI();
}

function getEquippedSkinObj() {
    return SKINS.find(s => s.id === saveData.equippedSkin) || SKINS[0];
}

// ==========================================
// 2. PROCEDURAL WEB AUDIO SYNTHESIZER
// ==========================================
class SynthAudio {
    constructor() {
        this.ctx = null;
    }

    init() {
        if (!this.ctx) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
            this.ctx.resume();
        }
    }

    playJump() {
        if (!saveData.soundEnabled) return;
        this.init();
        if (!this.ctx) return;

        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(260, now);
        osc.frequency.exponentialRampToValueAtTime(680, now + 0.14);

        gain.gain.setValueAtTime(0.22, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.15);
    }

    playLatch(combo = 1) {
        if (!saveData.soundEnabled) return;
        this.init();
        if (!this.ctx) return;

        const now = this.ctx.currentTime;
        const baseFreq = 320 + Math.min(combo * 55, 500);
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(baseFreq, now);
        osc.frequency.setValueAtTime(baseFreq * 1.25, now + 0.05);

        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.16);
    }

    playShard() {
        if (!saveData.soundEnabled) return;
        this.init();
        if (!this.ctx) return;

        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, now);
        osc.frequency.setValueAtTime(1320, now + 0.06);

        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.22);
    }

    playUnlock() {
        if (!saveData.soundEnabled) return;
        this.init();
        if (!this.ctx) return;

        const notes = [523.25, 659.25, 783.99, 1046.5];
        notes.forEach((freq, idx) => {
            const now = this.ctx.currentTime + idx * 0.06;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(0.2, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 0.18);
        });
    }

    playCrash() {
        if (!saveData.soundEnabled) return;
        this.init();
        if (!this.ctx) return;

        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(190, now);
        osc.frequency.exponentialRampToValueAtTime(42, now + 0.38);

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.4);
    }
}

const audio = new SynthAudio();

function triggerHaptic(ms = 18) {
    if (saveData.hapticsEnabled && navigator.vibrate) {
        try { navigator.vibrate(ms); } catch (e) {}
    }
}

// ==========================================
// 3. GAME ENGINE & ENTITIES
// ==========================================
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let cw = 400;
let ch = 700;

function resizeCanvas() {
    const rect = canvas.parentElement.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cw = rect.width;
    ch = rect.height;
    canvas.width = cw * dpr;
    canvas.height = ch * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
window.addEventListener('resize', resizeCanvas);

// Game States: 'MENU', 'PLAYING', 'PAUSED', 'GAMEOVER'
let gameState = 'MENU';
let score = 0;
let combo = 1;
let orbitRotations = 0;
let cameraY = 0;
let targetCameraY = 0;
let shakeTime = 0;
let shakeMagnitude = 0;
let hueTick = 0;
let bonusClaimedThisRun = false;

// Entities
let nodes = [];
let shards = [];
let particles = [];
let floatingTexts = [];
let bgStars = [];

const player = {
    x: 0,
    y: 0,
    vx: 0,
    vy: 0,
    radius: 9,
    state: 'ORBITING', // 'ORBITING' | 'FLYING'
    currentNode: null,
    angle: 0,
    orbitDir: 1,
    flightSpeed: 10.5,
    trail: []
};

function initStars() {
    bgStars = [];
    for (let i = 0; i < 55; i++) {
        bgStars.push({
            x: Math.random() * cw,
            y: Math.random() * ch,
            size: Math.random() * 2 + 0.6,
            alpha: Math.random() * 0.65 + 0.15,
            speedFactor: Math.random() * 0.35 + 0.1
        });
    }
}

function createNode(index, prevNode) {
    const margin = 65;
    let x = cw / 2;
    let y = ch * 0.72;

    if (prevNode) {
        const verticalGap = 175 + Math.min(index * 1.5, 45);
        y = prevNode.y - verticalGap;
        // Ensure horizontal spread without being too extreme
        x = margin + Math.random() * (cw - margin * 2);
    }

    const orbitRadius = index === 0 ? 52 : Math.max(40, 56 - Math.min(index * 0.4, 14));
    const baseSpeed = 0.042 + Math.min(index * 0.0011, 0.032);
    const dir = Math.random() > 0.5 ? 1 : -1;

    // Obstacles orbiting the node on higher scores
    const hazards = [];
    if (index >= 2) {
        const hazardChance = Math.min(0.25 + index * 0.03, 0.75);
        if (Math.random() < hazardChance) {
            const count = (index > 10 && Math.random() < 0.45) ? 2 : 1;
            const startAngle = Math.random() * Math.PI * 2;
            for (let c = 0; c < count; c++) {
                hazards.push({
                    angle: startAngle + c * Math.PI,
                    speed: -dir * (0.024 + Math.random() * 0.015),
                    dist: orbitRadius + 18,
                    radius: 7
                });
            }
        }
    }

    // Moving node horizontally at higher levels
    const isMoving = index > 5 && Math.random() < 0.35;

    const node = {
        index,
        x,
        baseX: x,
        y,
        coreRadius: 14,
        orbitRadius,
        speed: baseSpeed,
        dir,
        visited: index === 0,
        hazards,
        isMoving,
        movePhase: Math.random() * Math.PI * 2,
        moveRange: Math.min(45, (cw / 2) - margin),
        color: index % 2 === 0 ? '#00f3ff' : '#ff007f'
    };

    // Spawn collectible Star Shards between prevNode and this node
    if (prevNode) {
        const midX = (prevNode.x + node.x) / 2;
        const midY = (prevNode.y + node.y) / 2;
        shards.push({
            x: midX + (Math.random() - 0.5) * 30,
            y: midY + (Math.random() - 0.5) * 20,
            radius: 10,
            collected: false,
            pulse: Math.random() * Math.PI
        });
    }

    return node;
}

function resetGame() {
    score = 0;
    combo = 1;
    orbitRotations = 0;
    nodes = [];
    shards = [];
    particles = [];
    floatingTexts = [];
    bonusClaimedThisRun = false;

    const firstNode = createNode(0, null);
    nodes.push(firstNode);
    for (let i = 1; i < 8; i++) {
        nodes.push(createNode(i, nodes[nodes.length - 1]));
    }

    player.currentNode = firstNode;
    player.state = 'ORBITING';
    player.angle = -Math.PI / 2;
    player.orbitDir = firstNode.dir;
    player.trail = [];
    updatePlayerOrbitPosition();

    cameraY = player.y - ch * 0.7;
    targetCameraY = cameraY;

    updateHUD();
}

function updatePlayerOrbitPosition() {
    const n = player.currentNode;
    if (!n) return;
    player.x = n.x + Math.cos(player.angle) * n.orbitRadius;
    player.y = n.y + Math.sin(player.angle) * n.orbitRadius;
}

// Launch the player tangentially from the current orbit
function launchPlayer() {
    if (gameState !== 'PLAYING') return;
    if (player.state !== 'ORBITING' || !player.currentNode) return;

    const tangentAngle = player.angle + (player.orbitDir * Math.PI / 2);
    player.vx = Math.cos(tangentAngle) * player.flightSpeed;
    player.vy = Math.sin(tangentAngle) * player.flightSpeed;
    player.state = 'FLYING';

    audio.playJump();
    triggerHaptic(14);
    spawnParticles(player.x, player.y, getEquippedSkinObj().glowColor, 10, 2.5);
}

function spawnParticles(x, y, color, count = 16, maxSpeed = 4.5) {
    for (let i = 0; i < count; i++) {
        const ang = Math.random() * Math.PI * 2;
        const spd = Math.random() * maxSpeed + 0.8;
        particles.push({
            x,
            y,
            vx: Math.cos(ang) * spd,
            vy: Math.sin(ang) * spd,
            radius: Math.random() * 3 + 1.5,
            alpha: 1,
            decay: Math.random() * 0.025 + 0.018,
            color
        });
    }
}

function spawnFloatingText(x, y, text, color = '#00f3ff') {
    floatingTexts.push({
        x,
        y,
        text,
        color,
        alpha: 1,
        vy: -1.4
    });
}

function triggerScreenShake(mag = 6, duration = 10) {
    shakeMagnitude = mag;
    shakeTime = duration;
}

// ==========================================
// 4. MAIN UPDATE LOOP
// ==========================================
function updateGame() {
    hueTick = (hueTick + 2) % 360;

    // Screen Shake Decay
    if (shakeTime > 0) shakeTime--;

    // Smooth Camera Follow
    if (gameState === 'PLAYING') {
        targetCameraY = (player.currentNode ? player.currentNode.y : player.y) - ch * 0.68;
        cameraY += (targetCameraY - cameraY) * 0.1;
    } else if (gameState === 'MENU') {
        // Gentle idle camera drift on menu
        cameraY -= 0.4;
    }

    // Update Nodes & Hazards
    for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        if (n.isMoving) {
            n.movePhase += 0.025;
            n.x = n.baseX + Math.sin(n.movePhase) * n.moveRange;
        }
        for (let h of n.hazards) {
            h.angle += h.speed;
        }
    }

    if (gameState === 'PLAYING') {
        if (player.state === 'ORBITING' && player.currentNode) {
            const n = player.currentNode;
            const dAngle = n.speed * player.orbitDir;
            player.angle += dAngle;
            orbitRotations += Math.abs(dAngle);

            // Reset combo if player waits more than 1.25 full rotations
            if (orbitRotations > Math.PI * 2.5 && combo > 1) {
                combo = 1;
                updateHUD();
            }

            updatePlayerOrbitPosition();

            // Check collision with hazards on current node
            for (let h of n.hazards) {
                const hx = n.x + Math.cos(h.angle) * h.dist;
                const hy = n.y + Math.sin(h.angle) * h.dist;
                if (Math.hypot(player.x - hx, player.y - hy) < player.radius + h.radius) {
                    endGame('Eliminated by orbital security drone');
                    return;
                }
            }
        } else if (player.state === 'FLYING') {
            player.x += player.vx;
            player.y += player.vy;

            // Check collectible Star Shards
            for (let s of shards) {
                if (!s.collected && Math.hypot(player.x - s.x, player.y - s.y) < player.radius + s.radius + 6) {
                    s.collected = true;
                    saveData.shards += 1;
                    writeSaveData();
                    audio.playShard();
                    triggerHaptic(20);
                    spawnParticles(s.x, s.y, '#fbbf24', 15, 3.5);
                    spawnFloatingText(s.x, s.y, '+1 SHARD', '#fbbf24');
                }
            }

            // Check node capture or hazard collision
            for (let n of nodes) {
                // Hazard check first
                for (let h of n.hazards) {
                    const hx = n.x + Math.cos(h.angle) * h.dist;
                    const hy = n.y + Math.sin(h.angle) * h.dist;
                    if (Math.hypot(player.x - hx, player.y - hy) < player.radius + h.radius) {
                        endGame('Struck an orbital plasma mine');
                        return;
                    }
                }

                // Capture inside gravity ring of unvisited or different node
                if (n !== player.currentNode) {
                    const dist = Math.hypot(player.x - n.x, player.y - n.y);
                    if (dist <= n.orbitRadius + 14) {
                        // Latch onto new node!
                        player.state = 'ORBITING';
                        player.currentNode = n;
                        player.angle = Math.atan2(player.y - n.y, player.x - n.x);

                        // Determine natural angular momentum direction via cross product
                        const rx = player.x - n.x;
                        const ry = player.y - n.y;
                        const cross = rx * player.vy - ry * player.vx;
                        player.orbitDir = cross >= 0 ? 1 : -1;

                        if (!n.visited) {
                            n.visited = true;
                            // Quick launch combo check
                            if (orbitRotations < Math.PI * 1.65) {
                                combo = Math.min(combo + 1, 8);
                            } else {
                                combo = 1;
                            }
                            orbitRotations = 0;

                            const pts = 1 * combo;
                            score += pts;
                            audio.playLatch(combo);
                            triggerHaptic(22);
                            triggerScreenShake(4, 6);
                            spawnParticles(n.x, n.y, n.color, 18, 4);

                            if (combo > 1) {
                                spawnFloatingText(n.x, n.y - 25, `PERFECT x${combo}! (+${pts})`, '#fbbf24');
                            } else {
                                spawnFloatingText(n.x, n.y - 20, `+${pts}`, '#00f3ff');
                            }

                            updateHUD();

                            // Generate new nodes ahead & prune old ones
                            while (nodes.length < n.index + 8) {
                                nodes.push(createNode(nodes[nodes.length - 1].index + 1, nodes[nodes.length - 1]));
                            }
                        } else {
                            audio.playLatch(1);
                        }
                        break;
                    }
                }
            }

            // Check out of bounds
            const screenY = player.y - cameraY;
            if (
                player.x < -30 ||
                player.x > cw + 30 ||
                screenY < -120 ||
                screenY > ch + 100
            ) {
                endGame('Drifted into deep space');
                return;
            }
        }

        // Record player trail
        player.trail.push({ x: player.x, y: player.y });
        if (player.trail.length > 18) player.trail.shift();
    }

    // Update Particles
    for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;
        if (p.alpha <= 0) particles.splice(i, 1);
    }

    // Update Floating Texts
    for (let i = floatingTexts.length - 1; i >= 0; i--) {
        const ft = floatingTexts[i];
        ft.y += ft.vy;
        ft.alpha -= 0.022;
        if (ft.alpha <= 0) floatingTexts.splice(i, 1);
    }
}

// ==========================================
// 5. RENDER PIPELINE
// ==========================================
function renderGame() {
    ctx.save();

    // Dynamic Background Gradient that shifts hue slightly as score climbs
    const bgHue = (235 + Math.floor(score / 10) * 18) % 360;
    const grad = ctx.createLinearGradient(0, 0, 0, ch);
    grad.addColorStop(0, `hsl(${bgHue}, 65%, 5%)`);
    grad.addColorStop(1, `hsl(${(bgHue + 25) % 360}, 60%, 9%)`);
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, cw, ch);

    // Apply Camera Shake
    if (shakeTime > 0) {
        const dx = (Math.random() - 0.5) * shakeMagnitude;
        const dy = (Math.random() - 0.5) * shakeMagnitude;
        ctx.translate(dx, dy);
    }

    // Draw Parallax Starfield
    ctx.fillStyle = '#ffffff';
    for (let s of bgStars) {
        let sy = (s.y - cameraY * s.speedFactor) % ch;
        if (sy < 0) sy += ch;
        ctx.globalAlpha = s.alpha;
        ctx.beginPath();
        ctx.arc(s.x, sy, s.size, 0, Math.PI * 2);
        ctx.fill();
    }
    ctx.globalAlpha = 1;

    // Subtle Grid Lines
    ctx.strokeStyle = 'rgba(0, 243, 255, 0.04)';
    ctx.lineWidth = 1;
    const gridStep = 60;
    const offsetY = (-cameraY) % gridStep;
    for (let x = 0; x < cw; x += gridStep) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, ch);
        ctx.stroke();
    }
    for (let y = offsetY; y < ch; y += gridStep) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(cw, y);
        ctx.stroke();
    }

    // Translate World by CameraY
    ctx.save();
    ctx.translate(0, -cameraY);

    // Draw faint guide line connecting sequential nodes
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
    ctx.setLineDash([5, 7]);
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        if (i === 0) ctx.moveTo(n.x, n.y);
        else ctx.lineTo(n.x, n.y);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    // Draw Collectible Star Shards
    for (let s of shards) {
        if (s.collected) continue;
        if (s.y - cameraY < -50 || s.y - cameraY > ch + 50) continue;

        s.pulse += 0.08;
        const r = s.radius + Math.sin(s.pulse) * 2;

        ctx.save();
        ctx.translate(s.x, s.y);
        ctx.rotate(s.pulse * 0.5);
        ctx.shadowColor = '#fbbf24';
        ctx.shadowBlur = 12;
        ctx.fillStyle = '#fde047';
        ctx.beginPath();
        ctx.moveTo(0, -r);
        ctx.lineTo(r * 0.65, 0);
        ctx.lineTo(0, r);
        ctx.lineTo(-r * 0.65, 0);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
    }

    // Draw Gravity Nodes & Hazards
    for (let n of nodes) {
        if (n.y - cameraY < -120 || n.y - cameraY > ch + 120) continue;

        // Outer Gravity Ring
        ctx.save();
        ctx.strokeStyle = n.visited ? 'rgba(0, 243, 255, 0.45)' : 'rgba(255, 0, 128, 0.45)';
        ctx.lineWidth = 2;
        ctx.setLineDash([8, 6]);
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.orbitRadius, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);

        // Inner Core
        ctx.shadowColor = n.visited ? '#00f3ff' : '#ff007f';
        ctx.shadowBlur = 16;
        ctx.fillStyle = n.visited ? '#00f3ff' : '#ff007f';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.coreRadius, 0, Math.PI * 2);
        ctx.fill();

        // Core Center Highlight
        ctx.fillStyle = '#070714';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.coreRadius * 0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        // Draw Orbiting Red Hazards
        for (let h of n.hazards) {
            const hx = n.x + Math.cos(h.angle) * h.dist;
            const hy = n.y + Math.sin(h.angle) * h.dist;
            ctx.save();
            ctx.shadowColor = '#ff1e42';
            ctx.shadowBlur = 12;
            ctx.fillStyle = '#ff1e42';
            ctx.beginPath();
            ctx.arc(hx, hy, h.radius, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(hx, hy, h.radius * 0.4, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }
    }

    // Draw Player & Aiming Trajectory when playing
    if (gameState === 'PLAYING' || gameState === 'PAUSED') {
        const skin = getEquippedSkinObj();

        // Aiming Laser Line while orbiting (helps player time tangential jumps)
        if (player.state === 'ORBITING' && player.currentNode) {
            const tangentAngle = player.angle + (player.orbitDir * Math.PI / 2);
            const aimLen = 85;
            const tx = player.x + Math.cos(tangentAngle) * aimLen;
            const ty = player.y + Math.sin(tangentAngle) * aimLen;

            const aimGrad = ctx.createLinearGradient(player.x, player.y, tx, ty);
            aimGrad.addColorStop(0, 'rgba(255, 255, 255, 0.55)');
            aimGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.strokeStyle = aimGrad;
            ctx.lineWidth = 2;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(player.x, player.y);
            ctx.lineTo(tx, ty);
            ctx.stroke();
            ctx.setLineDash([]);
        }

        // Player Ribbon Trail
        for (let i = 0; i < player.trail.length; i++) {
            const pt = player.trail[i];
            const ratio = (i + 1) / player.trail.length;
            ctx.fillStyle = skin.trailColor === 'rainbow'
                ? `hsl(${(hueTick + i * 12) % 360}, 100%, 60%)`
                : skin.trailColor;
            ctx.globalAlpha = ratio * 0.55;
            ctx.beginPath();
            ctx.arc(pt.x, pt.y, player.radius * ratio * 0.9, 0, Math.PI * 2);
            ctx.fill();
        }
        ctx.globalAlpha = 1;

        // Player Orb Core
        ctx.save();
        const activeGlow = skin.trailColor === 'rainbow'
            ? `hsl(${hueTick}, 100%, 60%)`
            : skin.glowColor;
        ctx.shadowColor = activeGlow;
        ctx.shadowBlur = 20;
        ctx.fillStyle = activeGlow;
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = skin.coreColor;
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius * 0.55, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }

    // Draw Explosion Particles
    for (let p of particles) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 8;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }

    // Draw Floating Score / Shard Popups
    for (let ft of floatingTexts) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, ft.alpha);
        ctx.font = '900 13px Orbitron, sans-serif';
        ctx.fillStyle = ft.color;
        ctx.textAlign = 'center';
        ctx.shadowColor = ft.color;
        ctx.shadowBlur = 8;
        ctx.fillText(ft.text, ft.x, ft.y);
        ctx.restore();
    }

    ctx.restore(); // End world camera transform
    ctx.restore(); // End screen shake transform
}

function gameLoop() {
    if (gameState !== 'PAUSED') {
        updateGame();
    }
    renderGame();
    requestAnimationFrame(gameLoop);
}

